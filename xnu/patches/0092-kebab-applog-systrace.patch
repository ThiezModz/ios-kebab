+/*
+ * Bring-up aid, boot-arg applog=1: what applications and other programs started without a
+ * terminal say is worth reading here. Their standard output and error, which launchd opens on
+ * /dev/null, go to the console instead (that shows NSLog and the "Terminating app due to
+ * uncaught exception" kind of message). applog_name=NAME[,NAME...] with applog=1 does that
+ * for the programs whose file names begin with one of the NAMEs only, which is how to read
+ * what one application extension has to say.
+ */
+static uint32_t exec_applog;
+static char exec_applog_name[128];
+static uint32_t exec_applog_parsed;
+
+static void
+exec_applog_parse(void)
+{
+	if (!exec_applog_parsed) {
+		exec_applog_parsed = 1;
+		PE_parse_boot_argn("applog", &exec_applog, sizeof(exec_applog));
+		PE_parse_boot_argn("applog_name", exec_applog_name, sizeof(exec_applog_name));
+	}
+}
+
+static const char *
+exec_applog_path(int fd, const char *path)
+{
+	exec_applog_parse();
+	if (exec_applog && (fd == 1 || fd == 2) && strcmp(path, "/dev/null") == 0) {
+		return "/dev/console";
+	}
+	return path;
+}
